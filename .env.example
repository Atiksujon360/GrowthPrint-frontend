# NEXT_PUBLIC_API_BASE_URL: Base URL for the GrowthPrint backend API
# Set to http://localhost:8090/api/v1 for local development
# Set to production API URL for deployed environments
NEXT_PUBLIC_API_BASE_URL="http://localhost:8090/api/v1"

# NEXT_PUBLIC_USE_MOCK_API: Set to "false" to use real API, "true" to use mock data
NEXT_PUBLIC_USE_MOCK_API="false"

# NEXT_PUBLIC_ENABLE_WORKSPACE_PREVIEW: "true" shows the MVP2 business-workspace preview (sample data).
# Leave unset or "false" in production; scripts/check-prod-env.mjs fails a production build if it is "true".
NEXT_PUBLIC_ENABLE_WORKSPACE_PREVIEW="false"
